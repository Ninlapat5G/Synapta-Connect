{
  "productName": "Synapta Connect",
  "identifier": "tech.synapta.connect",
  "build": { "frontendDist": "../frontend/dist-desktop" },
  "app": {
    "windows": [
      { "label": "main", "title": "Synapta Connect", "windowClassname": "SynaptaConnectDesktop", "visible": false, "width": 1240, "height": 850, "minWidth": 420, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [{
        "identifier": "desktop",
        "windows": ["main"],
        "permissions": ["allow-agent-request", "allow-service-status", "allow-service-control", "allow-open-web"]
      }]
    }
  },
  "bundle": { "active": false, "icon": ["../installer/windows/assets/synapta-connect.ico", "../frontend/assets/synapta-connect.png"] }
}
